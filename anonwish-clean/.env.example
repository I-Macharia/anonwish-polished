DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Without a key, emails are logged and skipped.
RESEND_API_KEY=
EMAIL_FROM=AnonWish <onboarding@resend.dev>

# Generate: openssl rand -hex 32
DONOR_HASH_SECRET=
# Generate: openssl rand -base64 32  (must decode to exactly 32 bytes)
RECEIPT_ENCRYPTION_KEY=
# Placeholder-email domain for providers that require a payer email
ANON_EMAIL_DOMAIN=example.com

# Payments: a provider is active only if listed here AND its keys are set.
PAYMENTS_ENABLED=stripe,flutterwave,paystack,mpesa
PLATFORM_FEE_BPS=500
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYSTACK_SECRET_KEY=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random string appended to the Daraja callback URL (Daraja callbacks are unsigned)
MPESA_CALLBACK_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=false
